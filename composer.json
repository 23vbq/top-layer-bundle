{
    "name": "23vbq/top-layer-bundle",
    "description": "Native <dialog> modals, drawers and toasts for Symfony with Turbo and Stimulus",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "bundle",
        "symfony-ux",
        "dialog",
        "modal",
        "drawer",
        "toast",
        "popover",
        "turbo",
        "stimulus"
    ],
    "authors": [
        {
            "name": "23vbq"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/stimulus-bundle": "^2.0 || ^3.0",
        "symfony/twig-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/ux-turbo": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/asset-mapper": "^6.4 || ^7.0 || ^8.0"
    },
    "suggest": {
        "symfony/asset-mapper": "To load the bundle's Stimulus controllers without a JS build step"
    },
    "autoload": {
        "psr-4": {
            "Vbq23\\TopLayerBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vbq23\\TopLayerBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix"
    }
}
