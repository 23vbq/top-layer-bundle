<div class="top-layer-header">
    {% if title %}
        <h2 id="{{ id }}-title" class="top-layer-title">{{ title }}</h2>
    {% endif %}

    <button type="button" data-action="23vbq--top-layer-bundle--dialog#close" aria-label="{{ closeLabel }}" class="top-layer-close">
        <span class="top-layer-close__icon">{{ source('@TopLayer/svg/close.svg') }}</span>
    </button>
</div>
