<div class="flex h-[52px] shrink-0 items-center gap-3 border-b border-line px-5">
    {% if title %}
        <h2 id="{{ id }}-title" class="text-[15px] font-semibold text-ink">{{ title }}</h2>
    {% endif %}

    <button type="button" data-action="dialog#close" aria-label="Close"
            class="ml-auto grid h-7 w-7 cursor-pointer place-items-center rounded-md text-muted transition-colors hover:bg-surface-hover hover:text-ink">
        <span class="w-[13px]">{{ source('svg/close.svg') }}</span>
    </button>
</div>
