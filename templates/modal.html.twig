{%- set width = width|default(null) -%}
{%- set height = height|default(null) -%}
{%- set title = title|default(null) -%}
{%- set frame_class = frame_class|default(null) -%}
<dialog id="{{ id }}"
        data-23vbq--top-layer-bundle--dialog-target="dialog"
        {% if title %}aria-labelledby="{{ id }}-title"{% endif %}
        {% if width %}style="--top-layer-width: {{ width }}"{% endif %}
        class="top-layer-modal">
    <div class="top-layer-modal__panel"{% if height %} style="--top-layer-height: {{ height }}"{% endif %}>
        {{ include('@TopLayer/_dialog_header.html.twig', {id: id, title: title}, with_context: false) }}

        <turbo-frame id="{{ turboFrameId }}" class="top-layer-frame{% if frame_class %} {{ frame_class }}{% endif %}"></turbo-frame>
    </div>
</dialog>
