{%- set type = type in top_layer_toast_types() ? type : 'info' -%}
{%- set title = flash.title|default(flash) -%}
{%- set message = flash.message|default(null) -%}
{%- set delay = top_layer_toast_delay(type) -%}
<div class="top-layer-toast top-layer-toast--{{ type }}"
     role="{{ top_layer_toast_role(type) }}"
     data-controller="23vbq--top-layer-bundle--toast"
     data-23vbq--top-layer-bundle--toast-delay-value="{{ delay }}"
     data-action="pointerenter->23vbq--top-layer-bundle--toast#pause pointerleave->23vbq--top-layer-bundle--toast#resume">
    <span class="top-layer-toast__icon">{{ source('@TopLayer/svg/toast-' ~ type ~ '.svg') }}</span>

    <div class="top-layer-toast__body">
        <div class="top-layer-toast__title">{{ title }}</div>
        {% if message %}
            <div class="top-layer-toast__message">{{ message }}</div>
        {% endif %}
    </div>

    <button type="button" data-action="23vbq--top-layer-bundle--toast#dismiss" aria-label="{{ dismissLabel|default('Dismiss') }}" class="top-layer-toast__dismiss">
        <span class="top-layer-toast__dismiss-icon">{{ source('@TopLayer/svg/close.svg') }}</span>
    </button>

    {% if 0 < delay %}
        <div data-23vbq--top-layer-bundle--toast-target="progress" class="top-layer-toast__progress"></div>
    {% endif %}
</div>
