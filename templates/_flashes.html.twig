{%- for type, messages in app.flashes(top_layer_toast_types()) -%}
    {%- for message in messages -%}
        <turbo-stream action="append" target="{{ top_layer_toasts_container_id() }}">
            <template>{{ include('@TopLayer/toast.html.twig', {type: type, flash: message, dismissLabel: dismissLabel|default(null)}, with_context: false) }}</template>
        </turbo-stream>
    {%- endfor -%}
{%- endfor -%}
