{
    "name": "@23vbq/top-layer-bundle",
    "description": "Native <dialog> modals, drawers and toasts for Symfony with Turbo and Stimulus",
    "version": "0.1.0",
    "license": "MIT",
    "type": "module",
    "keywords": [
        "symfony-ux"
    ],
    "symfony": {
        "controllers": {
            "dialog": {
                "main": "src/dialog_controller.js",
                "fetch": "eager",
                "enabled": true,
                "autoimport": {
                    "@23vbq/top-layer-bundle/styles/top-layer.css": true
                }
            },
            "toast": {
                "main": "src/toast_controller.js",
                "fetch": "lazy",
                "enabled": true,
                "autoimport": {
                    "@23vbq/top-layer-bundle/styles/top-layer.css": true
                }
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0",
            "@hotwired/turbo": "^8.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0",
        "@hotwired/turbo": "^8.0"
    }
}
